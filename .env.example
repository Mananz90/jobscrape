# Optional: forward proxy for all outbound requests (residential/rotating proxy recommended for hostile sites)
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080
# Global politeness settings
JOBSCRAPE_CONCURRENCY=4
JOBSCRAPE_MIN_DELAY_MS=500
JOBSCRAPE_DB=data/jobs.db
JOBSCRAPE_PORT=3210
# Adzuna (optional job board API): https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- search sources that need keys (all optional; keyless sources work without any of these) ---
# APIFY_TOKEN=            # Indeed, Glassdoor, ZipRecruiter, Naukri, StepStone, LinkedIn-at-volume via Apify actors (pay per result)
# JOOBLE_API_KEY=         # Jooble aggregator, 70 countries (free key)
# USAJOBS_API_KEY=  USAJOBS_EMAIL=
# BRAVE_API_KEY=          # reliable company discovery (search engine); DuckDuckGo HTML is the keyless fallback
# ANTHROPIC_API_KEY=      # CV/JD understanding with Claude (falls back to heuristic extraction)
# JOBSCRAPE_MODEL=claude-opus-5
# JOBSCRAPE_LINKEDIN_DETAILS=10   # how many LinkedIn results get full descriptions per search (each is a request)
# --- alerts ---
# JOBSCRAPE_WEBHOOK_URL=  # Slack/Discord incoming webhook for new-job alerts from `schedule`
# JOBSCRAPE_DESKTOP_NOTIFY=1

# --- real-browser sources ---
# JOBSCRAPE_BROWSER_CHANNEL=chrome   # use installed Google Chrome (recommended for Indeed/Glassdoor)
# JOBSCRAPE_HEADFUL=1                # always show the browser window
# JOBSCRAPE_BROWSER_DETAILS=15       # how many results get full descriptions per browser search
# JOBSCRAPE_BROWSER_PROFILE=data/browser-profile
# JOBSCRAPE_NO_ESCALATE=1            # never open a visible window automatically
# SERPAPI_KEY=             # Google for Jobs aggregator (LinkedIn/Indeed/Glassdoor postings per country), free tier 100 searches/month
# JOBSCRAPE_SCRAPLING_PYTHON=scrapling/.venv/bin/python   # Scrapling sidecar interpreter (npm run setup:scrapling)

# --- matching & alerts (from the jobsnag merge) ---
# OLLAMA_HOST=http://localhost:11434     # semantic matching needs `ollama pull nomic-embed-text`; JOBSCRAPE_SEMANTIC=0 disables
# JOBSCRAPE_EMBED_MODEL=nomic-embed-text
# JOBSCRAPE_EMBED_MAX=400                # new jobs embedded per ranking call
# JOBSCRAPE_MAX_PER_COMPANY=6            # cap in daily digests
# TELEGRAM_CHAT_ID=                      # your chat id (message @userinfobot)
# TELEGRAM_BOT_TOKEN=                    # or TELEGRAM_TOKEN_FILE=~/.hermes/.env to reuse an existing bot's token without copying it
# --- daily run tuning ---
# JOBSCRAPE_MAX_AGE_DAYS=40        # hard ceiling on posting age in digests
# JOBSCRAPE_LINKEDIN_PAUSE_MS=10000 # pause between consecutive saved searches that hit LinkedIn
# JOBSCRAPE_HEALTH_ALERTS=1        # notify when a source fails or its fetch count halves
# JOBSCRAPE_TIMEOUT_MS=45000        # per-request timeout; a request that times out twice is given up
